@@ -6,10 +6,12 @@ use std::path::Path;
 
 use rustix::fs as rfs;
 
-#[cfg(not(target_os = "macos"))]
+// Darwin spells "no such attribute" ENOATTR; Linux reuses ENODATA. iOS is
