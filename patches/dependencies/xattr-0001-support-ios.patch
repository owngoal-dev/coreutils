diff --git a/src/sys/mod.rs b/src/sys/mod.rs
--- a/src/sys/mod.rs
+++ b/src/sys/mod.rs
@@ -28,7 +28,12 @@ macro_rules! platforms {
     }
 }
 
+// iOS shares Darwin's extended-attribute interface with macOS: the same
+// getxattr/setxattr/listxattr/removexattr with the same XATTR_NOFOLLOW and
+// position arguments, all exported from libSystem. Without this line the crate
+// falls back to its `unsupported` module and every call returns an error, which
+// surfaces as `cp: setting attributes for '...': unsupported platform`.
 platforms! {
-    "android"; "linux"; "macos"; "hurd" => linux_macos,
+    "android"; "linux"; "macos"; "ios"; "hurd" => linux_macos,
     "freebsd"; "netbsd" => bsd
 }
