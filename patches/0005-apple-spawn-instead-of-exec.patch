+
+// Restore process-wide dispositions before unblocking on a failed launch.
+struct SignalState {
+    mask: SigSet,
+    actions: Vec<(Signal, SigAction)>,
+}
+
+impl Drop for SignalState {
+    fn drop(&mut self) {
+        for (signal, action) in self.actions.iter().rev() {
+            let _ = unsafe { sigaction(*signal, action) };
+        }
+        let _ = self.mask.thread_set_mask();
+    }
+}
+
+fn spawn_result(code: libc::c_int) -> io::Result<()> {
+    if code == 0 {
+        Ok(())
+    } else {
+        Err(io::Error::from_raw_os_error(code))
+    }
+}
+
+/// A child owned by the native spawn path. Cache its terminal status so a
+/// later wait cannot reap a recycled PID after an earlier try_wait succeeded.
+pub struct SpawnedChild {
+    pid: Pid,
+    status: Option<ExitStatus>,
+}
+
+impl SpawnedChild {
+    pub fn wait(&mut self) -> io::Result<ExitStatus> {
+        self.wait_with_flags(0).map(Option::unwrap)
+    }
+
+    pub fn try_wait(&mut self) -> io::Result<Option<ExitStatus>> {
+        self.wait_with_flags(libc::WNOHANG)
+    }
+
+    fn wait_with_flags(&mut self, flags: libc::c_int) -> io::Result<Option<ExitStatus>> {
+        if self.status.is_some() {
+            return Ok(self.status);
+        }
+        let mut status = 0;
+        loop {
+            match unsafe { libc::waitpid(self.pid.as_raw(), &mut status, flags) } {
+                -1 if Errno::last() == Errno::EINTR => continue,
+                -1 => return Err(io::Error::last_os_error()),
+                0 => return Ok(None),
+                _ => {
+                    self.status = Some(ExitStatus::from_raw(status));
+                    return Ok(self.status);
+                }
+            }
+        }
+    }
+}
+
+impl ChildExt for SpawnedChild {
+    fn send_signal(&mut self, signal: usize) -> io::Result<()> {
+        super::unix::send_signal(self.pid.as_raw() as u32, signal)
+    }
+
+    fn send_signal_group(&mut self, signal: usize) -> io::Result<()> {
+        super::unix::send_signal_group(signal)
+    }
+
+    fn wait_or_timeout(&mut self, timeout: Duration, ignore_term: bool) -> io::Result<TimeoutRet> {
+        if timeout.is_zero() {
+            return self.wait().map(TimeoutRet::Exited);
+        }
+        super::unix::wait_or_timeout(timeout, ignore_term, || self.try_wait())
+    }
+}
+
+/// Spawn with an explicit child signal mask and inherited environment and fds.
+/// argv includes argv[0]. Only SETSIGMASK is used; SETEXEC is never an option.
+pub fn spawn<S: AsRef<OsStr>>(
+    program: &OsStr,
+    argv: impl IntoIterator<Item = S>,
+    mask: &SigSet,
+) -> io::Result<SpawnedChild> {
+    let program = CString::new(program.as_bytes())?;
+    let argv = argv
+        .into_iter()
+        .map(|arg| CString::new(arg.as_ref().as_bytes()))
+        .collect::<Result<Vec<_>, _>>()?;
+    let mut pointers: Vec<_> = argv.iter().map(|arg| arg.as_ptr().cast_mut()).collect();
+    pointers.push(ptr::null_mut());
+
+    let mut attr = ptr::null_mut();
+    spawn_result(unsafe { libc::posix_spawnattr_init(&mut attr) })?;
+    let mut pid = 0;
+    let spawned = (|| {
+        spawn_result(unsafe { libc::posix_spawnattr_setsigmask(&mut attr, mask.as_ref()) })?;
+        spawn_result(unsafe {
+            libc::posix_spawnattr_setflags(&mut attr, libc::POSIX_SPAWN_SETSIGMASK as _)
+        })?;
+        // No SETEXEC, pre-exec callback, credential change, or fork fallback.
+        spawn_result(unsafe {
+            libc::posix_spawnp(
+                &mut pid,
+                program.as_ptr(),
+                ptr::null(),
+                &attr,
+                pointers.as_ptr(),
+                *libc::_NSGetEnviron(),
+            )
+        })
+    })();
+    unsafe { libc::posix_spawnattr_destroy(&mut attr) };
+    spawned?;
+    Ok(SpawnedChild {
+        pid: Pid::from_raw(pid),
+        status: None,
+    })
+}
+
+/// Run a terminal utility through ordinary posix_spawnp, returning only on error.
+/// `argv` includes argv[0]. The caller must be single-threaded and must not own
+/// another child. Unlike exec, this leaves a waiting parent with a distinct PID;
+/// SIGKILL/SIGSTOP sent only to that parent cannot be forwarded.
+pub fn spawn_and_wait<S: AsRef<OsStr>>(
+    program: &OsStr,
+    argv: impl IntoIterator<Item = S>,
+) -> io::Error {
+    let result: io::Result<Infallible> = (|| {
+        // Synchronous faults must keep their normal disposition. All other
+        // catchable signals are relayed, including signals the child initially
+        // blocks or ignores but may later enable itself.
+        let mut pending = SigSet::all();
+        for signal in [
+            Signal::SIGKILL,
+            Signal::SIGSTOP,
+            Signal::SIGILL,
+            Signal::SIGTRAP,
+            Signal::SIGABRT,
+            Signal::SIGEMT,
+            Signal::SIGFPE,
+            Signal::SIGBUS,
+            Signal::SIGSEGV,
+            Signal::SIGSYS,
+        ] {
+            pending.remove(signal);
+        }
+        let mut state = SignalState {
+            mask: SigSet::thread_get_mask()?,
+            actions: Vec::new(),
+        };
+        pending.thread_block()?;
+
+        // Darwin needs a caught SIGCHLD to wake sigwait. An explicitly ignored
+        // SIGCHLD would also auto-reap a fast child. Spawn resets this caught
+        // disposition to default in the child, as POSIX permits for SIGCHLD.
+        extern "C" fn wake(_: libc::c_int) {}
+        let action = SigAction::new(SigHandler::Handler(wake), SaFlags::empty(), SigSet::empty());
+        let default = SigAction::new(SigHandler::SigDfl, SaFlags::empty(), SigSet::empty());
+        state.actions.push((Signal::SIGCHLD, unsafe {
+            sigaction(Signal::SIGCHLD, &action)
+        }?));
+
+        let child = spawn(program, argv, &state.mask)?.pid;
+
+        let waited = (|| -> io::Result<WaitStatus> {
+            for signal in pending.iter().filter(|sig| *sig != Signal::SIGCHLD) {
+                state
+                    .actions
+                    .push((signal, unsafe { sigaction(signal, &action) }?));
+            }
+            // The parent must not hold pipeline endpoints open after the child
+            // closes them. From here it only waits and relays signals.
+            for fd in 0..=2 {
+                unsafe { libc::close(fd) };
+            }
+            loop {
+                match waitpid(child, Some(WaitPidFlag::WNOHANG | WaitPidFlag::WUNTRACED)) {
+                    Ok(status @ (WaitStatus::Exited(..) | WaitStatus::Signaled(..))) => {
+                        return Ok(status);
+                    }
+                    Ok(WaitStatus::Stopped(..)) => {
+                        raise(Signal::SIGSTOP)?;
+                    }
+                    Err(Errno::EINTR) => continue,
+                    Ok(_) => {}
+                    Err(error) => return Err(error.into()),
+                }
+                let mut signal = 0;
+                spawn_result(unsafe { libc::sigwait(pending.as_ref(), &mut signal) })?;
+                // Darwin can wake with signal 0 under a debugger; recheck the child.
+                if signal != 0 && signal != libc::SIGCHLD {
+                    kill(child, Signal::try_from(signal)?).or_else(|error| {
+                        if error == Errno::ESRCH {
+                            Ok(())
+                        } else {
+                            Err(error)
+                        }
+                    })?;
+                }
+            }
+        })();
+        if waited.is_err() {
+            let _ = kill(child, Signal::SIGKILL);
+            while matches!(waitpid(child, None), Err(Errno::EINTR)) {}
+        }
+        let status = waited?;
+        match status {
+            WaitStatus::Exited(_, code) => std::process::exit(code),
+            WaitStatus::Signaled(_, signal, _) => {
+                if signal != Signal::SIGKILL {
+                    unsafe { sigaction(signal, &default) }?;
+                }
+                let mut unblocked = SigSet::empty();
+                unblocked.add(signal);
+                unblocked.thread_unblock()?;
+                raise(signal)?;
+                std::process::exit(128 + signal as i32);
+            }
+            _ => unreachable!(),
+        }
+    })();
+    result.unwrap_err()
+}
