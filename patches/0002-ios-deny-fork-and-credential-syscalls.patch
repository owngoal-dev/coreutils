diff --git a/src/bin/coreutils.rs b/src/bin/coreutils.rs
--- a/src/bin/coreutils.rs
+++ b/src/bin/coreutils.rs
@@ -13,6 +13,61 @@ use uucore::{Args, error::strip_errno};
 
 const VERSION: &str = env!("CARGO_PKG_VERSION");
 
+// Apple targets: make fork() and the credential syscalls impossible, not merely
+// unused.
+//
+// Every process this binary starts goes through posix_spawn(); `std` only falls
+// back to fork() + exec() when a `Command` carries a pre_exec closure or a
+// uid/gid/groups override, and none of the utilities ask for either. But `std`
+// keeps that fallback compiled in, so the import stays. On iOS this process has
+// the Objective-C runtime and Foundation loaded and forking it is not safe, so
+// define the symbol here instead of importing it. Under this crate's `lto =
+// "fat"` release profile the definition is inlined into that fallback and no
+// `_fork` import is left in the Mach-O at all; without LTO it would still be
+// what our own code binds to, while libSystem and every other library keep
+// calling their own fork() through the two-level namespace.
+//
+// Reaching this is a bug. Failing with EPERM turns it into an error message
+// from whichever utility tried, instead of a child process in an undefined
+// state.
+#[cfg(target_vendor = "apple")]
+#[unsafe(no_mangle)]
+pub extern "C" fn fork() -> i32 {
+    deny()
+}
+
+// The same for the credential syscalls. `std` reaches these from the child half
+// of that fork path, when a `Command` carries a uid, gid or supplementary group
+// list; no utility here asks for one, and with chroot dropped (see Cargo.toml)
+// nothing calls them directly either. A process that starts unprivileged and
+// spawns children that inherit what it already has never needs to assume an
+// identity, so deny the whole family rather than leave it linked. Dropping
+// privilege is a different thing and is untouched: `nice` still lowers its own
+// priority and `timeout` still calls setpgid().
+#[cfg(target_vendor = "apple")]
+#[unsafe(no_mangle)]
+pub extern "C" fn setuid(_uid: uucore::libc::uid_t) -> i32 {
+    deny()
+}
+
+#[cfg(target_vendor = "apple")]
+#[unsafe(no_mangle)]
+pub extern "C" fn setgid(_gid: uucore::libc::gid_t) -> i32 {
+    deny()
+}
+
+#[cfg(target_vendor = "apple")]
+#[unsafe(no_mangle)]
+pub extern "C" fn setgroups(_size: core::ffi::c_int, _list: *const uucore::libc::gid_t) -> i32 {
+    deny()
+}
+
+#[cfg(target_vendor = "apple")]
+fn deny() -> i32 {
+    unsafe { *uucore::libc::__error() = uucore::libc::EPERM };
+    -1
+}
+
 include!(concat!(env!("OUT_DIR"), "/uutils_map.rs"));
 
