# Where uutils coreutils' source comes from. This repository is not a fork: the
# tree is fetched at the pinned ref and the patches in patches/ are applied on
# top.
#
# UPSTREAM_REF is a full commit sha on purpose. patches/ is context-sensitive,
# so a moving branch turns "the build broke" into "which of the last twenty
# upstream commits broke it". Bump it deliberately:
#
#     make bump-upstream REF=<sha>
#
UPSTREAM_REPO=https://github.com/uutils/coreutils.git
UPSTREAM_REF=bf65901e1ed82963436844c2cf8e796ba9158c65

# The multi-call binary. One executable holds every utility and picks which one
# to run from argv[0]; on Apple targets that dispatch is pure argv[0]
# (src/common/validation.rs), so the symlinks the package installs work.
# CARGO_DIR is relative to the checkout root.
CARGO_DIR=.
CARGO_PACKAGE=coreutils
CARGO_BIN=coreutils
PROGRAM=coreutils

# Which utilities go in. feat_os_unix_musl is upstream's own "unix without
# stdbuf" set: stdbuf needs a cdylib whose link passes GNU ld's `-z defs`, which
# ld64 rejects, and DYLD_INSERT_LIBRARIES does not work against a
# platform-signed process anyway, so stdbuf could not work on iOS regardless.
# feat_diagnostics is the default caret-under-the-argument error rendering.
CARGO_FEATURES=feat_os_unix_musl,feat_diagnostics


# RootHide rewrites path-related Mach-O imports after linking, so the binary
# resolves absolute paths inside the randomized jbroot the way the shell does --
# without it `ls /etc` on roothide would list the real iOS /etc. Pin the build
# tool just like fish so release output does not depend on a moving branch. Only
# the roothide package is rewritten; the rootless one must not load libvrootapi.
SYMREDIRECT_REPO=https://github.com/owngoal-dev/libroothide.git
SYMREDIRECT_REF=7764c54759009272b4f2f23c18c62b21794fe6dd

# Upstream sets rust-version = "1.88.0" as its MSRV and ships no
# rust-toolchain.toml, so the packaging repo pins the compiler itself.
RUST_TOOLCHAIN=1.98.1

# Deployment target. 15.0 is the floor of the jailbreaks this is packaged for.
MIN_IOS=15.0
ARCH=arm64
